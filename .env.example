# Aurelia Cathērine — Environment Configuration

# Public application configuration
NEXT_PUBLIC_SITE_URL="https://aureliacatherine.com"
NEXT_PUBLIC_APP_NAME="Aurelia Cathērine"

# Authentication & Database
DATABASE_URL="postgresql://user:password@localhost:5432/aurelia_db"
AUTH_SECRET="super-secret-jwt-key-replace-in-production"

# Payment Gateway (QRIS, Virtual Accounts, E-Wallet)
PAYMENT_API_URL="https://api.sandbox.midtrans.com/v2"
PAYMENT_API_KEY="SB-Mid-server-sample-key"

# Storage / Assets CDN
STORAGE_URL="https://storage.googleapis.com/aurelia-assets"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

